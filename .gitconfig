[user]
	email = oza777you@gmail.com
	name = Ozaki Yoichi

[core]
	pager = delta
	editor = vim
	autocrlf = input
	excludesfile = ~/.gitignore_global

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
	syntax-theme = Catppuccin Mocha

[diff]
	colorMoved = default

[merge]
	conflictstyle = diff3

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[init]
	defaultBranch = main

[alias]
	st = status -s
	co = checkout
	br = branch
	lg = log --oneline --graph --decorate --all
	undo = reset --soft HEAD~1
	unstage = restore --staged
	aliases = config --get-regexp alias
	recent = branch --sort=-committerdate --format='%(refname:short)' | head -10
